<resources>
    <style name="Theme.StandByPlus" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@color/background_oled</item>
        <item name="android:navigationBarColor">@color/background_oled</item>
        <item name="android:windowBackground">@color/background_oled</item>
    </style>

    <style name="Theme.StandByPlus.Fullscreen" parent="Theme.StandByPlus">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:keepScreenOn">true</item>
    </style>
</resources>
